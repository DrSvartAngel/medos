{
  "expo": {
    "name": "MedOS",
    "slug": "drsvartangel",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/branding/medos-icon.png",
    "scheme": "medos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medos.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/medos-adaptive-foreground.png",
        "backgroundColor": "#111412",
        "monochromeImage": "./assets/branding/medos-adaptive-monochrome.png"
      },
      "package": "com.medos.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/branding/medos-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-sqlite",
        {
          "enableFTS": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "67cfe2e8-4de0-4585-bc8b-dcec35d393e6"
      }
    },
    "owner": "drsvartangels-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/67cfe2e8-4de0-4585-bc8b-dcec35d393e6"
    }
  }
}
